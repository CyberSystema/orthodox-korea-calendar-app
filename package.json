{
  "name": "orthodox-korea-calendar-app",
  "version": "1.0.0",
  "main": "index.ts",
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-native",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-svg",
        "react-native-worklets",
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "postinstall": "patch-package",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "sideload:ios": "expo run:ios --device --configuration Release",
    "sideload:android": "JAVA_HOME=$(/usr/libexec/java_home -v 21) ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} expo run:android --device --variant release",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "sync:calendar-data": "node scripts/sync-calendar-data.mjs",
    "check:calendar-data": "node scripts/sync-calendar-data.mjs --check",
    "check:scaled-text": "node scripts/check-scaled-text.mjs",
    "doctor": "npx expo-doctor",
    "prebuild": "expo prebuild",
    "build:android:preview": "npm run check:calendar-data && npm run check:scaled-text && npm run check:android-icon && npm run check:tab-icons && npx eas build -p android --profile preview",
    "build:ios:preview": "npm run check:calendar-data && npm run check:scaled-text && npx eas build -p ios --profile preview",
    "build:android:production": "npm run check:calendar-data && npm run check:scaled-text && npm run check:android-icon && npm run check:tab-icons && npx eas build -p android --profile production",
    "build:ios:production": "npm run check:calendar-data && npm run check:scaled-text && npx eas build -p ios --profile production",
    "submit:android": "npx eas submit -p android --latest",
    "submit:ios": "npx eas submit -p ios --latest",
    "update:production": "npm run typecheck && npm run check:calendar-data && npm run check:scaled-text && node scripts/publish-update.mjs --profile production",
    "update:preview": "npm run typecheck && npm run check:calendar-data && npm run check:scaled-text && node scripts/publish-update.mjs --profile preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:android-icon": "node scripts/sync-android-icon.mjs",
    "sync:tab-icons": "node scripts/generate-tab-icons.mjs",
    "check:tab-icons": "node scripts/generate-tab-icons.mjs --check",
    "check:android-icon": "node scripts/sync-android-icon.mjs --check"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "dayjs": "^1.11.21",
    "expo": "^57.0.8",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.10",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-native": "^0.86.2",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-reanimated": "^4.5.3",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.11.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "babel-preset-expo": "^57.0.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "private": true
}
