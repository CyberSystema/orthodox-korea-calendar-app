{
  "name": "orthodox-korea-calendar-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "postinstall": "patch-package",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "sideload:ios": "expo run:ios --device --configuration Release",
    "sideload:android": "JAVA_HOME=$(/usr/libexec/java_home -v 21) ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} expo run:android --device --variant release",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "sync:calendar-data": "node scripts/sync-calendar-data.mjs",
    "check:calendar-data": "node scripts/sync-calendar-data.mjs --check",
    "check:scaled-text": "node scripts/check-scaled-text.mjs",
    "doctor": "npx expo-doctor",
    "prebuild": "expo prebuild",
    "build:android:preview": "npm run check:calendar-data && npm run check:scaled-text && npm run check:android-icon && npx eas build -p android --profile preview",
    "build:ios:preview": "npm run check:calendar-data && npm run check:scaled-text && npx eas build -p ios --profile preview",
    "build:android:production": "npm run check:calendar-data && npm run check:scaled-text && npm run check:android-icon && npx eas build -p android --profile production",
    "build:ios:production": "npm run check:calendar-data && npm run check:scaled-text && npx eas build -p ios --profile production",
    "submit:android": "npx eas submit -p android --latest",
    "submit:ios": "npx eas submit -p ios --latest",
    "update:production": "npm run typecheck && npm run check:calendar-data && npm run check:scaled-text && node scripts/publish-update.mjs --profile production",
    "update:preview": "npm run typecheck && npm run check:calendar-data && npm run check:scaled-text && node scripts/publish-update.mjs --profile preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:android-icon": "node scripts/sync-android-icon.mjs",
    "check:android-icon": "node scripts/sync-android-icon.mjs --check"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.18.3",
    "@react-navigation/native": "^7.3.4",
    "@react-navigation/native-stack": "^7.17.6",
    "dayjs": "^1.11.21",
    "expo": "^56.0.12",
    "expo-application": "~56.0.3",
    "expo-build-properties": "~56.0.19",
    "expo-constants": "~56.0.18",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.14",
    "expo-localization": "~56.0.6",
    "expo-network": "~56.0.5",
    "expo-notifications": "~56.0.18",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.19",
    "i18next": "^26.3.3",
    "react": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "babel-preset-expo": "~56.0.15",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "private": true
}
