{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_API_BASE_URL": "https://orthodox-korea-calendar-backend-staging.leontg.workers.dev",
        "EXPO_PUBLIC_ENABLE_SECRET_MENU": "false",
        "EXPO_PUBLIC_ONESIGNAL_APP_ID": "REPLACE_WITH_ONESIGNAL_APP_ID"
      },
      "autoIncrement": true
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_API_BASE_URL": "https://orthodox-korea-calendar-backend-production.leontg.workers.dev",
        "EXPO_PUBLIC_ENABLE_SECRET_MENU": "false",
        "EXPO_PUBLIC_ONESIGNAL_APP_ID": "REPLACE_WITH_ONESIGNAL_APP_ID"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6785077515"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal"
      }
    }
  }
}
