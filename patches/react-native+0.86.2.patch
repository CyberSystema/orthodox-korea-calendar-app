+#pragma mark - Fabric view recycling
+
+// Opt TextInput out of New Architecture view recycling. iOS Password AutoFill corrupts a
+// UITextField/UITextView that Fabric then RECYCLES into its pool; the recycled input comes
+// back frozen / non-editable until an app background+foreground cycle
+// (facebook/react-native#53050). Recreating the view instead of pooling it avoids the
+// corruption. Applied via patch-package.
++ (BOOL)shouldBeRecycled
+{
+  return NO;
+}
