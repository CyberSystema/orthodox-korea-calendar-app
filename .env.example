# Backend API URL — auto-selected per build type:
#   __DEV__ builds  → https://orthodox-korea-calendar-backend.leontg.workers.dev
#   Production      → https://orthodox-korea-calendar-backend-production.leontg.workers.dev
#   Preview (EAS)   → https://orthodox-korea-calendar-backend-staging.leontg.workers.dev (set in eas.json)
# Override locally for dev if needed:
# EXPO_PUBLIC_APP_API_BASE_URL=https://orthodox-korea-calendar-backend-staging.leontg.workers.dev

# Optional direct calendar-data base URL ending with /data/
# Example: https://your-mobile-api.your-domain.com/data/
EXPO_PUBLIC_CALENDAR_DATA_BASE_URL=
