# Backend API URL — auto-selected per build type:
#   __DEV__ builds  → https://orthodox-korea-calendar-backend.leontg.workers.dev
#   Production      → https://orthodox-korea-calendar-backend-production.leontg.workers.dev
#   Preview (EAS)   → https://orthodox-korea-calendar-backend-staging.leontg.workers.dev (set in eas.json)
# Override locally for dev if needed:
# EXPO_PUBLIC_APP_API_BASE_URL=https://orthodox-korea-calendar-backend-staging.leontg.workers.dev

# Optional direct calendar-data base URL ending with /data/
# Example: https://your-mobile-api.your-domain.com/data/
EXPO_PUBLIC_CALENDAR_DATA_BASE_URL=

# Owner-only secret admin console (7-tap on the brand title).
# OFF by default. EAS/store builds force this "false" via eas.json, so the
# console does not exist in any released build (Apple guideline 2.3.1).
# To enable it on a LOCAL sideload of your own device, create a gitignored
# `.env.local` containing:  EXPO_PUBLIC_ENABLE_SECRET_MENU=true
# EXPO_PUBLIC_ENABLE_SECRET_MENU=false

# OneSignal App ID. PUBLIC — a UUID that ships in every client bundle, so it is not
# a secret (the App API Key is, and lives only as a Cloudflare Worker secret).
# Set per profile in eas.json; src/services/notifications/oneSignal.ts also carries a
# committed fallback, so a local sideload has working push without setting this.
# There is no APNs environment switch any more: OneSignal routes each token to the
# right APNs gateway itself, which is the whole reason EXPO_PUBLIC_APNS_ENV is gone.
# EXPO_PUBLIC_ONESIGNAL_APP_ID=
