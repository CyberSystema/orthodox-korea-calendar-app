{
  "expo": {
    "name": "Orthodox Korea Calendar",
    "slug": "orthodox-korea-calendar-app",
    "version": "1.0.0",
    "scheme": "okncalendar",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cybersystema.okncalendar",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:orthodox-korea-calendar.pages.dev"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cybersystema.okncalendar",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "orthodox-korea-calendar.pages.dev",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#5C1414",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#3A0A0A"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "calendar-reminders",
          "mode": "production",
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ]
  }
}
