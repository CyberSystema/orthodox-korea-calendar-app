{
  "expo": {
    "name": "OK Calendar",
    "slug": "orthodox-korea-calendar-app",
    "version": "1.1",
    "scheme": "okncalendar",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "buildNumber": "1",
      "supportsTablet": true,
      "bundleIdentifier": "com.cybersystema.okncalendar",
      "appleTeamId": "4S3VW22A8G",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:orthodox-korea-calendar.pages.dev"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 9,
      "package": "com.cybersystema.okncalendar",
      "backgroundColor": "#3A0A0A",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "orthodox-korea-calendar.pages.dev",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#5C1414",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withSolidLaunchScreen",
      "./plugins/withIosSceneLifecycle",
      "./plugins/withMinIosDeploymentTarget",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "//": "iOS: NO top-level image — ./plugins/withSolidLaunchScreen (listed first, runs last via withMod LIFO) replaces expo-splash-screen's storyboard with a solid-color UILaunchScreen that references the SplashScreenBackground asset generated from the top-level backgroundColor (#3A0A0A), keeping the launch flash-free. Android: an image IS required — withAndroidSplashStyles ALWAYS writes windowSplashScreenAnimatedIcon=@drawable/splashscreen_logo into the Android 12 splash theme, so with no image the drawable is never generated and the release build fails at processReleaseResources (resource splashscreen_logo not found). The android block supplies the brand mark (the masking-padded adaptive foreground) so the drawable exists; Android 12 always renders a splash icon anyway. This android block does not affect the iOS config.",
          "backgroundColor": "#3A0A0A",
          "android": {
            "backgroundColor": "#3A0A0A",
            "image": "./assets/android-icon-foreground.png",
            "imageWidth": 200
          }
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "calendar-reminders",
          "mode": "production",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-build-properties",
        {
          "//": "Force every CocoaPods target to the app's minimum iOS version. Some sub-pods (e.g. RNSVG-RNSVGFilters) hardcode 12.4, which the current Xcode rejects (min supported is 15.0); this post_install bumps them all to match.",
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "21936a71-5479-49a2-847d-f371c3806dab"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/21936a71-5479-49a2-847d-f371c3806dab"
    }
  }
}
