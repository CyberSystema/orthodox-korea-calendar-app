{
  "expo": {
    "name": "OK Calendar",
    "slug": "orthodox-korea-calendar-app",
    "version": "202609.1",
    "scheme": "okncalendar",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "2",
      "supportsTablet": true,
      "bundleIdentifier": "com.cybersystema.okncalendar",
      "appleTeamId": "4S3VW22A8G",
      "associatedDomains": [
        "applinks:orthodox-korea-calendar.pages.dev"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 11,
      "package": "com.cybersystema.okncalendar",
      "backgroundColor": "#3A0A0A",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "orthodox-korea-calendar.pages.dev",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#5C1414",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-empty.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withSolidLaunchScreen",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "disableNSE": true,
          "disableLocation": true,
          "iPhoneDeploymentTarget": "16.4",
          "smallIcons": [
            "./assets/notification-icon.png"
          ],
          "smallIconAccentColor": "#B8942E"
        }
      ],
      "./plugins/withPortraitOnly",
      "./plugins/withIosSceneLifecycle",
      "./plugins/withMinIosDeploymentTarget",
      "./plugins/withAndroidBuildMemory",
      "./plugins/withFastSplashExit",
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "//": "Both platforms launch into a BARE solid #3A0A0A (= colors.primaryDeep, the animated ByzantineSplashScreen's opening colour) so the native launch screen blends invisibly into the animation — no logo appears before it. iOS: NO top-level image — ./plugins/withSolidLaunchScreen (listed first, runs last via withMod LIFO) replaces expo-splash-screen's storyboard with a solid-colour UILaunchScreen built from backgroundColor. Android: an image IS still required — withAndroidSplashStyles ALWAYS writes windowSplashScreenAnimatedIcon=@drawable/splashscreen_logo into the Android 12 splash theme, so omitting it means the drawable is never generated and the release build fails at processReleaseResources (resource splashscreen_logo not found). We therefore point it at a FULLY TRANSPARENT png: the drawable exists (build succeeds) but renders nothing, so Android shows only the solid background — matching iOS. Do not swap this back to a logo. This android block does not affect the iOS config.",
          "backgroundColor": "#3A0A0A",
          "android": {
            "backgroundColor": "#3A0A0A",
            "image": "./assets/android-icon-empty.png",
            "imageWidth": 200
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "//": "Force every CocoaPods target to the app's minimum iOS version. Some sub-pods (e.g. RNSVG-RNSVGFilters) hardcode 12.4, which the current Xcode rejects (min supported is 15.0); this post_install bumps them all to match.",
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "21936a71-5479-49a2-847d-f371c3806dab"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/21936a71-5479-49a2-847d-f371c3806dab"
    }
  }
}
