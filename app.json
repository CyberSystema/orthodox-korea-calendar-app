{
  "expo": {
    "name": "Orthodox Korea Calendar",
    "slug": "orthodox-korea-calendar-app",
    "version": "1.0.0",
    "scheme": "okncalendar",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cybersystema.okncalendar",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:orthodox-korea-calendar.pages.dev"
      ],
      "infoPlist": {
        "NSUserNotificationUsageDescription": "Orthodox Korea Calendar sends liturgical reminders in your selected language."
      }
    },
    "android": {
      "package": "com.cybersystema.okncalendar",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "orthodox-korea-calendar.pages.dev",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#5C1414",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "calendar-reminders",
          "mode": "production",
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ]
  }
}
